{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/stac/ome-ngff/v0.1.0/schema.json",
  "title": "OME-NGFF Extension (experimental)",
  "description": "Image dimensions and structure of an OME-Zarr asset, for search.",
  "type": "object",
  "required": ["stac_extensions", "properties"],
  "properties": {
    "stac_extensions": {
      "type": "array",
      "contains": {"const": "https://example.org/stac/ome-ngff/v0.1.0/schema.json"}
    },
    "properties": {
      "type": "object",
      "required": ["ome:version"],
      "properties": {
        "ome:version": {"type": "string", "enum": ["0.4", "0.5"]},
        "ome:axes": {"type": ["string", "null"]},
        "ome:size_x": {"$ref": "#/definitions/size"},
        "ome:size_y": {"$ref": "#/definitions/size"},
        "ome:size_z": {"$ref": "#/definitions/size"},
        "ome:size_c": {"$ref": "#/definitions/size"},
        "ome:size_t": {"$ref": "#/definitions/size"},
        "ome:has_labels": {"type": "boolean"},
        "ome:plate": {"type": "boolean"},
        "idr:study": {"type": "string", "pattern": "^idr[0-9]{4}$"}
      }
    }
  },
  "definitions": {
    "size": {"type": ["integer", "null"], "minimum": 1}
  }
}
